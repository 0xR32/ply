+    /// Runs once per GPUI app before its window opens; only for global factories.
+    fn init(&self, _cx: &mut gpui::App) {}
+}
+
+type MakeFactory = fn() -> Box<dyn CustomElementFactory>;
+
+/// A static because an addon registers before any renderer, and so any registry, exists.
+static GLOBAL_FACTORIES: std::sync::Mutex<Vec<MakeFactory>> = std::sync::Mutex::new(Vec::new());
+
+/// Registers an element type for every renderer created after this call.
+/// A global factory replaces a built-in one with the same `element_type`.
+pub fn register_global_factory(make: MakeFactory) {
+    GLOBAL_FACTORIES
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .push(make);
+}
+
+fn global_factories() -> Vec<MakeFactory> {
+    GLOBAL_FACTORIES
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .clone()
+}
+
+pub(crate) fn init_global_factories(cx: &mut gpui::App) {
+    for make in global_factories() {
+        make().init(cx);
+    }
 }
 
